# Python virtual environment (rebuilt via install.bat)
.venv/
# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
# Old / generated output
exports/
# PyInstaller build output. RochNVRAM.spec is tracked: it is the build, not
# output of it. file_version_info.txt is generated into build/ from
# bios_manager/version.py, so it is not kept here either.
build/
dist/
# OS / editor cruft
Thumbs.db
.DS_Store
# Claude Code local tooling config (machine-specific permission allowlist)
.claude/
# Sample NVRAM dumps (board-specific; needed only for offline/dry-run mode)
data/
